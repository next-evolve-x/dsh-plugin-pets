{
  "name": "dsh-pets",
  "version": "0.1.2",
  "description": "Codex-style pets for DeepSeek Harness — animated spritesheet pets rendered in the web GUI, powered by the public codex-pets.net gallery.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./patch.yml"
    }
  },
  "files": [
    "lib",
    "README.md",
    "README.zh-CN.md",
    "patch.yml"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "pets",
    "codex-pets",
    "spritesheet",
    "plugin"
  ],
  "license": "MIT"
}
